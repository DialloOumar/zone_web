# --- Flask ---
SECRET_KEY=change-me-to-a-long-random-string
FLASK_APP=app.py
FLASK_DEBUG=0

# --- Database ---
# Local Docker: postgres://zone_user:${DB_PASSWORD}@db:5432/zone
DB_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://zone_user:change-me@db:5432/zone

# --- App settings ---
APP_DEFAULT_LANG=fr
GRACE_PERIOD_MINUTES=15

# --- Super admin bootstrap ---
# Created automatically by `flask seed` on first run. Refuses to overwrite an
# existing super admin, so it's safe to leave these set on redeploys.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-deploy
ADMIN_EMAIL=
ADMIN_FULL_NAME=Super Admin

# --- Linode Object Storage (slip + receipt photos) ---
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=

# --- Email (optional, for password reset later) ---
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=
